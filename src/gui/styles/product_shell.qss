/* VisionForge Product shell — distinct from Delivery vscode_dark */

* {
    font-family: "Cascadia Code", "JetBrains Mono", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #12161c;
    color: #d7e0ea;
}

QMainWindow {
    background-color: #12161c;
}

QMenuBar {
    background-color: #0d1117;
    color: #c9d1d9;
    border-bottom: 1px solid #1f6f4a;
    padding: 2px 0;
}

QMenuBar::item {
    background: transparent;
    padding: 7px 14px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #1a3d2e;
    color: #7dffa6;
}

QMenu {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
}

QMenu::item {
    padding: 7px 28px 7px 18px;
}

QMenu::item:selected {
    background-color: #1a3d2e;
    color: #7dffa6;
}

QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 4px 10px;
}

QToolBar {
    background-color: #0d1117;
    border-bottom: 1px solid #21262d;
    spacing: 4px;
    padding: 6px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    color: #c9d1d9;
}

QToolButton:hover {
    background-color: #1a2330;
    border-color: #30363d;
}

QToolButton:checked {
    background-color: #1a3d2e;
    border-color: #2ea043;
    color: #7dffa6;
}

QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #2ea043;
}

QPushButton:pressed {
    background-color: #1a3d2e;
}

QPushButton#detectConvertBtn {
    background-color: #238636;
    border-color: #2ea043;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#modeAnnotateBtn:checked,
QPushButton#modeDetectBtn:checked {
    background-color: #1a3d2e;
    border-color: #2ea043;
    color: #7dffa6;
}

QDockWidget {
    background-color: #0d1117;
    color: #c9d1d9;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #161b22;
    color: #7dffa6;
    padding: 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 11px;
}

QStatusBar {
    background-color: #0d1117;
    color: #8b949e;
    border-top: 1px solid #1f6f4a;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #30363d;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #2ea043;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QListWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
}

QListWidget::item:selected {
    background-color: #1a3d2e;
    color: #7dffa6;
}

QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
    color: #8b949e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #7dffa6;
}

QLabel#detectPanelTitle {
    color: #7dffa6;
    font-size: 15px;
    font-weight: 600;
}

QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 5px 8px;
    color: #e6edf3;
    selection-background-color: #1a3d2e;
}

QProgressBar {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    text-align: center;
    color: #c9d1d9;
}

QProgressBar::chunk {
    background-color: #2ea043;
    border-radius: 3px;
}

QTreeWidget, QTreeView {
    background-color: #0d1117;
    border: 1px solid #21262d;
    alternate-background-color: #161b22;
}

QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #30363d;
    padding: 6px;
}

QScrollBar:vertical {
    background: #0d1117;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QTabWidget::pane {
    border: 1px solid #30363d;
}

QTabBar::tab {
    background: #161b22;
    color: #8b949e;
    padding: 8px 14px;
    border: 1px solid #30363d;
    border-bottom: none;
}

QTabBar::tab:selected {
    background: #1a3d2e;
    color: #7dffa6;
}

QMessageBox {
    background-color: #161b22;
}

QDialog {
    background-color: #12161c;
}
